{
  "manifest_version": 3,
  "name": "TRX Chart Companion",
  "version": "1.0.0",
  "description": "Auto-track TRX WinGo bets and sync with TRX Chart",
  "author": "TRX Chart Team",
  
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  
  "host_permissions": [
    "https://6win598.com/*",
    "https://6lotteryapi.com/*",
    "https://*.6win598.com/*",
    "https://trx-chart.pages.dev/*"
  ],
  
  "content_scripts": [
    {
      "matches": [
        "https://6win598.com/*",
        "https://*.6win598.com/*"
      ],
      "js": ["content-script.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  
  "background": {
    "service_worker": "background.js"
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "TRX Chart Companion"
  },
  
  "externally_connectable": {
    "matches": [
      "https://trx-chart.pages.dev/*",
      "http://localhost:*/*"
    ]
  }
}
